# Server
PORT=3000

# Optional: API-Basketball (api-sports.io) — free tier ~100 requests/day.
# Used ONLY for leagues ESPN does not carry: German BBL, Lithuania LKL,
# FIBA Champions League, Mexico LNBP. Cached 5+ minutes. Not a 15s poller.
# Sign up: https://dashboard.api-sports.io/  (API-Basketball product)
API_BASKETBALL_KEY=

# Optional later: The Odds API for FanDuel totals fill (not used in v1; paste lines).
ODDS_API_KEY=

# Set to 1 to skip ESPN college boards (noisier, many games).
SKIP_NCAAB=0
