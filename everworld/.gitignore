# test-time libraries: run `npm install` in nm/
nm/node_modules/
# the data cache is rebuilt with the fetch tools (see NOTES.md); only the compact game files and learned lessons are kept
data/*
!data/derived/
!data/lessons/
data/derived/sitprior-*.json.gz
data/lessons/*.tmp.json
data/lessons/*.gz
# images are not needed for comparisons
baseline/**/icons/
baseline/**/screens/
gg/static/screens/
# these two came down from the Space as LFS pointer stubs, not real images (they are never changed here)
gg/static/icons/icon-512.png
gg/static/icons/maskable-512.png
data/lessons/*.log
# lab test lessons (split-season P1, final exam P2, shipping fit P3) appear while jobs run: the ones a reported number rests on are added by hand (git add -f) at the end of a round
data/lessons/P[0-9][MKH]-*.json
data/lessons/H4-*.json
